{
  "name": "task-manager",
  "version": "0.1.0.0",
  "private": true,
  "description": "Connected Microsoft To-Do Fluent Task Manager Module Federation Remote",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:git": "node scripts/dev.mjs --git",
    "dev:local": "node scripts/dev.mjs --local",
    "build": "rsbuild build",
    "preview": "rsbuild preview --port 3002",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "release": "node scripts/release.mjs",
    "release:verify": "node scripts/release.mjs --verify"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.6.5",
    "@module-federation/rsbuild-plugin": "^0.6.5",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-react": "^1.0.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
