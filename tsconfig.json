{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"],
    "paths": {
      "mfe-bus": ["./src/vendor/mfe-bus/index.ts"],
      "@avdgabriel/mfe-bus": ["./src/vendor/mfe-bus/index.ts"]
    }
  },
  "include": ["src"]
}
